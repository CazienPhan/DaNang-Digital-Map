# Backend environment variables
# Copy this file to backend/.env and replace placeholder values with your own.

PORT=5000
DATABASE_URL=postgres://username:password@localhost:5432/your_database_name
MAP4D_API_KEY=YOUR_MAP4D_API_KEY_HERE

# --- Product search (Meilisearch) ---
MEILISEARCH_HOST=YOUR_MEILISEARCH_HOST_HERE
MEILISEARCH_ADMIN_KEY=YOUR_MEILISEARCH_ADMIN_KEY_HERE

# --- Supabase (database, auth, product media/storage) ---
SUPABASE_URL=YOUR_SUPABASE_URL_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

