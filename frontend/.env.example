# Frontend environment variables
# Copy this file to frontend/.env and replace placeholder values with your own.

VITE_MAP4D_MAP_KEY=YOUR_PUBLIC_MAP4D_MAP_KEY_HERE
VITE_MAP4D_API_KEY=YOUR_PUBLIC_MAP4D_API_KEY_HERE
VITE_BACKEND_URL=http://localhost:5000

# --- Product search (Meilisearch) ---
VITE_MEILI_HOST=YOUR_MEILISEARCH_HOST_HERE
VITE_MEILI_SEARCH_KEY=YOUR_MEILISEARCH_SEARCH_KEY_HERE

